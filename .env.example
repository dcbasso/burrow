# Copie para .env e preencha. O .env real nunca é commitado (ver .gitignore).

# OAuth 2.0 Client ID (Web) criado no Google Cloud Console.
# Authorized JavaScript origins devem incluir as origens de onde o app é servido:
#   http://localhost:8090          docker local — porta publicada pelo web no compose
#   http://localhost:4200          dev Angular com `ng serve` (opcional)
#   https://seu-dominio.exemplo    produção, atrás do seu reverse proxy
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Allowlist de e-mails que podem logar (separados por vírgula).
ALLOWED_EMAILS=voce@exemplo.com

# Connection string do Mongo. Default = container do compose.
# O banco se chama `homelab` por herança da primeira versão; os dados vivem lá.
MONGO_URI=mongodb://mongo:27017/homelab
