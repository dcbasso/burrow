# Ambiente de demonstração. Copie para .env e ajuste apenas as duas linhas abaixo.

# 1) Seu e-mail do Google. É a allowlist: só quem está aqui consegue logar.
ALLOWED_EMAILS=voce@gmail.com

# 2) OAuth 2.0 Client ID (Web), criado de graça no Google Cloud Console:
#    APIs & Services > Credentials > Create credentials > OAuth client ID > Web application
#    Em "Authorized JavaScript origins", adicione: http://localhost:8090
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# O banco e os dados de exemplo já vêm configurados — não precisa mexer em mais nada.

# Opcional: porta do dashboard no host. Só mude se a 8090 já estiver ocupada
# (ex.: você já roda o Burrow de verdade). Se mudar, use a mesma origem no Google Console.
# WEB_PORT=8099
